# ── Stage 1: Dependencies ────────────────────────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --legacy-peer-deps

# ── Stage 2: Build ───────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_CREDITTN_MOBILE_MODE
ARG NEXT_PUBLIC_CREDITTN_DOWNLOAD_BASE_URL
ARG NEXT_PUBLIC_CREDITTN_DOWNLOAD_LANDING_URL
ARG NEXT_PUBLIC_CREDITTN_EXPO_GO_URL
ARG NEXT_PUBLIC_CREDITTN_ANDROID_APK_URL
ARG NEXT_PUBLIC_CREDITTN_GOOGLE_PLAY_URL
ARG NEXT_PUBLIC_CREDITTN_APP_STORE_URL
ARG NEXT_PUBLIC_CREDITTN_DEEP_LINK_SCHEME
ENV NEXT_PUBLIC_CREDITTN_MOBILE_MODE=$NEXT_PUBLIC_CREDITTN_MOBILE_MODE
ENV NEXT_PUBLIC_CREDITTN_DOWNLOAD_BASE_URL=$NEXT_PUBLIC_CREDITTN_DOWNLOAD_BASE_URL
ENV NEXT_PUBLIC_CREDITTN_DOWNLOAD_LANDING_URL=$NEXT_PUBLIC_CREDITTN_DOWNLOAD_LANDING_URL
ENV NEXT_PUBLIC_CREDITTN_EXPO_GO_URL=$NEXT_PUBLIC_CREDITTN_EXPO_GO_URL
ENV NEXT_PUBLIC_CREDITTN_ANDROID_APK_URL=$NEXT_PUBLIC_CREDITTN_ANDROID_APK_URL
ENV NEXT_PUBLIC_CREDITTN_GOOGLE_PLAY_URL=$NEXT_PUBLIC_CREDITTN_GOOGLE_PLAY_URL
ENV NEXT_PUBLIC_CREDITTN_APP_STORE_URL=$NEXT_PUBLIC_CREDITTN_APP_STORE_URL
ENV NEXT_PUBLIC_CREDITTN_DEEP_LINK_SCHEME=$NEXT_PUBLIC_CREDITTN_DEEP_LINK_SCHEME
RUN mkdir -p public
RUN npm run build

# ── Stage 3: Runtime ─────────────────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000
ENV PORT=3000

CMD ["node", "server.js"]
