# Database
DB_ROOT_PASSWORD=change_me_in_production
DB_USER=creaditn
DB_PASSWORD=change_me_in_production
DB_PORT=3307
PHPMYADMIN_PORT=8081

# JWT
# Must be at least 32 random characters.
JWT_SECRET=replace-with-a-long-random-secret-string-here

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.email@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM=your.email@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_SMTP_SSL_TRUST=smtp.gmail.com
APP_PASSWORD_RESET_BASE_URL=http://localhost:3000/forgot-password
APP_PASSWORD_RESET_EXPIRY_MINUTES=30
ADMIN_NOTIFICATION_EMAIL=admin@bnpl.com
ADMIN_NOTIFICATION_EMAIL_ENABLED=false

# Socket.IO
SOCKET_EMIT_SECRET=replace-with-random-secret
SOCKET_DEBUG=false

# Admin panel
ADMIN_EMAIL=admin@bnpl.com
ADMIN_PASSWORD=change_me_in_production
APP_DEV_RESET_ENABLED=false
APP_DEV_RESET_TOKEN=
APP_CREDIT_MAX_PER_USER=2000

# Dashboard / Next.js
BACKEND_URL=http://localhost:8082
NEXT_PUBLIC_API_URL=/api/backend
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXTAUTH_SECRET=replace-with-a-long-random-nextauth-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CreditTN mobile download / QR landing
# Use a public HTTPS domain in production. For phone testing on LAN, use your PC IP, for example http://192.168.1.20:3010.
NEXT_PUBLIC_CREDITTN_DOWNLOAD_BASE_URL=
NEXT_PUBLIC_CREDITTN_QR_CODE_URL=https://yourdomain.com/download
NEXT_PUBLIC_CREDITTN_ANDROID_APK_URL=https://yourdomain.com/app/credittn.apk
NEXT_PUBLIC_CREDITTN_APP_STORE_URL=https://apps.apple.com/app/your-app-id
NEXT_PUBLIC_CREDITTN_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=tn.credittn.app
NEXT_PUBLIC_CREDITTN_EXPO_GO_URL=
NEXT_PUBLIC_CREDITTN_EXPO_DEV_BUILD_URL=
NEXT_PUBLIC_CREDITTN_DEEP_LINK_SCHEME=creditn://

# Didit KYC API
DIDIT_API_KEY=your_didit_api_key_here
DIDIT_API_URL=https://verification.didit.me/v3
DIDIT_ACCESS_TOKEN=
DIDIT_FALLBACK_ON_ERROR=false
# Local/demo only. Keep false in production.
KYC_DEV_AUTO_APPROVE=false
KYC_FACE_MATCH_THRESHOLD=0.75
KYC_FACE_MATCH_MANUAL_REVIEW_THRESHOLD=0.70
KYC_LIVENESS_THRESHOLD=0.70
KYC_LIVENESS_MANUAL_REVIEW_THRESHOLD=0.65
KYC_PROVIDER_CONFIDENCE_THRESHOLD=0.75
KYC_PROVIDER_CONFIDENCE_MANUAL_REVIEW_THRESHOLD=0.70
KYC_MAX_IMAGE_BYTES=5242880
KYC_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
KYC_IDENTITY_LOCK_INCLUDE_DELETED=true
